{% set ctx = context %}
{% if ctx.agent_profile %}
Active Agent: {{ ctx.agent_profile.name|capitalize }} ({{ ctx.agent_profile.kind }})
Description: {{ ctx.agent_profile.description }}
Goals: {{ ctx.agent_profile.goals | join('; ') if ctx.agent_profile.goals else 'N/A' }}
Tone: {{ ctx.agent_profile.tone or 'neutral' }}
Constraints: {{ ctx.agent_profile.constraints | join('; ') if ctx.agent_profile.constraints else 'standard policies' }}
{% else %}
No agent profile specified.
{% endif %}
